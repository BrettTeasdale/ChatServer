# PostgreSQL settings shared by docker-compose.yml and config/runtime.exs.
# Copy this file to .env and fill in a real password.

POSTGRESQL_USERNAME=chat_server
POSTGRESQL_PASSWORD=change_me
POSTGRESQL_DATABASE=chat_server
# Port exposed on the host (container always listens on 5432).
POSTGRESQL_PORT=5532
# Hostname the Phoenix app connects to. Use "localhost" when running mix on the host.
POSTGRESQL_HOSTNAME=localhost
